# Required for AI Evaluation Engine
GEMINI_API_KEY=

# Optional — only needed if USE_MOCK_VISION=false
GOOGLE_VISION_API_KEY=

# Hash pepper for address fingerprints
ADDRESS_HASH_PEPPER=hackathon-pepper-change-in-prod

# Toggle external API calls (set true for offline demo)
USE_MOCK_VISION=true
USE_MOCK_GEMINI=false
