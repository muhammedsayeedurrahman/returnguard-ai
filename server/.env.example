# ─── AI Evaluation Engine ─────────────────────────────────────────────
# Get from https://aistudio.google.com/apikey (free tier: 15 RPM, 1500 RPD)
GEMINI_API_KEY=
USE_MOCK_GEMINI=false

# ─── Google Vision (optional — image-text consistency) ────────────────
# Get from Google Cloud Console → Credentials, enable "Cloud Vision API"
# Free tier: $300 credit, $1.50/1k requests
GOOGLE_VISION_API_KEY=
USE_MOCK_VISION=true

# ─── Google Address Validation (India ML model) ───────────────────────
# Get from Google Cloud Console → Credentials, enable "Address Validation API"
# Free tier: $200/mo credit (~11,700 calls at $0.017/call)
# Indian-region ML model auto-applies when regionCode="IN"
GOOGLE_MAPS_API_KEY=
USE_MOCK_ADDRESS=true

# ─── Internal ─────────────────────────────────────────────────────────
ADDRESS_HASH_PEPPER=hackathon-pepper-change-in-prod
